# 架构与外部工具链（Linaro 4.9.4，路径由 Makefile 替换 @SDK_TOOLS@）
BR2_arm=y
BR2_cortex_a7=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PATH="@SDK_TOOLS@"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-buildroot-linux-gnueabihf"
BR2_TOOLCHAIN_EXTERNAL_GCC_11=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_9=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y

# 系统基础
BR2_TARGET_GENERIC_HOSTNAME="imx6ull"
BR2_TARGET_GENERIC_ISSUE="Welcome to IMX6ULL SDK"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="@BOARD_DIR@/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="@BOARD_DIR@/post-build.sh"

# 包：首跑最小集（busybox 自带），以后要加包在这里或 menuconfig 加
# BR2_PACKAGE_DROPBEAR=y 之类，按需开启

# host 工具：genimage 合成镜像、mkimage 打 boot.scr
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y

# 文件系统：ext4
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="128M"

# 内核和 uboot 由 SDK 统一编排，这里明确关闭
# BR2_LINUX_KERNEL is not set
# BR2_TARGET_UBOOT is not set
BR2_PRIMARY_SITE="https://mirrors.tuna.tsinghua.edu.cn/buildroot"
